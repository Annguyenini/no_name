      "text": "Images(I): \n    max-size 5mb\nVideo(V): \n    max-size 10mb,\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
