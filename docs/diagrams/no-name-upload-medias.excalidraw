      "isDeleted": false,
      "boundElements": [],
      "updated": 1792304708622,
      "created": 1792303249600,
      "link": null,
      "locked": false,
      "text": "We will let user upload medias straight into aws.\nFlow: \n1. user-> request upload -> backend -> save\nmedia ids -> request singed urls -> return to\nuser\n2. user -> upload to aws -> request confirm on\nthe upload success list ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "RC8BIfASfADFj65ezFbMZ",
      "originalText": "We will let user upload medias straight into aws. \nFlow: \n1. user-> request upload -> backend -> save media ids -> request singed urls -> return to user\n2. user -> upload to aws -> request confirm on the upload success list ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
