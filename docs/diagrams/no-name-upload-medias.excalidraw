    {
      "id": "iPVjPapBA38WQQGcWyyUO",
      "type": "text",
      "x": -1185.9463827443797,
      "y": 239.9932898740176,
      "width": 482.57958984375,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9q",
      "roundness": null,
      "seed": 1357385758,
      "version": 1577,
      "versionNonce": 414590622,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792302538176,
      "created": 1792301765076,
      "link": null,
      "locked": false,
      "text": "NOTES: wait time start when backend have urls\nready (doesn't count time that user request\nupload and backend request urls)\n\nmax Wait time: \nlatency time from backend return urls to user +\nlatency from user to cloud  + time user upload to\ncloud ( I*30 + V*60) + cloud trigger to server+\nnotification trace \n\n2s+2s+(I*30+V*60)+2s+30s\n\nex: if user want to upload 2 images, 1 video:\nlatency from backend to user:2s\nlatency from user to cloud: 2s\nupload: ((2*30) + (1*60)): 120s\nlatency from cloud to backend: 2s\nnotification trace from cloud to backend +30s\nin total: 156s\nThe backend should have 2 images and 1 video\nconfirm uploaded by cloud in maximum 156s to be\nconsider as success.\nIf not success, backend trigger sync request",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "fizx9yIRSSMEcJRNI2mcG",
      "originalText": "NOTES: wait time start when backend have urls ready (doesn't count time that user request upload and backend request urls)\n\nmax Wait time: \nlatency time from backend return urls to user + latency from user to cloud  + time user upload to cloud ( I*30 + V*60) + cloud trigger to server+ notification trace \n\n2s+2s+(I*30+V*60)+2s+30s\n\nex: if user want to upload 2 images, 1 video:\nlatency from backend to user:2s\nlatency from user to cloud: 2s\nupload: ((2*30) + (1*60)): 120s\nlatency from cloud to backend: 2s\nnotification trace from cloud to backend +30s\nin total: 156s\nThe backend should have 2 images and 1 video confirm uploaded by cloud in maximum 156s to be consider as success.\nIf not success, backend trigger sync request",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
